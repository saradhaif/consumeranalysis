      <aliases enabled='yes' />
      <column caption='discounts %' datatype='real' default-format='p0%' name='[Calculation_1034983538982191104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Discount])/SUM([Sales])) * 100' />
      </column>
      <column caption='% of discounts from each Order id' datatype='real' name='[Calculation_1034983538999054337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Discount])/COUNTD([Order ID]))* 100' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_1034983539238936580]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Discount])/COUNTD([Order ID])' />
      </column>
      <column caption='discount % of average sales' datatype='real' name='[Calculation_1034983539241975813]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(AVG([Discount]))/ SUM([Sales])' />
      </column>
      <column caption='arrow check discount' datatype='string' name='[Calculation_1034983539247222790]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Discount])&gt;20 THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
      </column>
      <column caption='Net Sales' datatype='real' name='[Calculation_1034983539538280464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Sales] - [Discount]' />
      </column>
      <column caption='Recency' datatype='real' name='[Calculation_1034983539567546385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_PERCENTILE(MIN(DATEDIFF(&apos;day&apos;, [Order Date], TODAY())), &apos;asc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Frequency' datatype='real' name='[Calculation_1034983539567706130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_PERCENTILE(COUNT([Order ID]), &apos;asc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Monetary' datatype='real' name='[Calculation_1034983539570823187]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_PERCENTILE(SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Average order per customer' datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Calculation_1034983539576029205]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales])/COUNTD([Customer Name])' />
      </column>
      <column caption='Last purchase date' datatype='date' name='[Calculation_1034983539578552345]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([Order Date])' />
      </column>
      <column caption='Days since last purchase' datatype='real' default-format='*# days;#.0 years' name='[Calculation_1034983539578777626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [Calculation_1034983539578552345],MAKEDATE(2024,1,1))&lt; 365&#13;&#10;THEN DATEDIFF(&apos;day&apos;, [Calculation_1034983539578552345],MAKEDATE(2024,1,1))&#13;&#10;ELSE -DATEDIFF(&apos;day&apos;,[Calculation_1034983539578552345], MAKEDATE(2024,1,1))/365&#13;&#10;END' />
      </column>
      <column caption='table&apos;s discount' datatype='real' name='[Calculation_1156017780044673026]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Sub-Category] = &quot;Tables&quot; THEN [Discount] END' />
      </column>
      <column caption='RFM new' datatype='string' name='[Calculation_1156017780352905219]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_718605665807216655] == 111&#13;&#10;THEN &apos;Best Customers&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_718605665807216655] == 144&#13;&#10;THEN &apos;Engaged but Infrequent&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_718605665807216655] == 142 OR [Calculation_718605665807216655]==143&#13;&#10;THEN &apos;Potentially valuable&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_718605665807216655] == 134&#13;&#10;THEN &apos;New Customer with Potential&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_718605665807216655] == 133 OR [Calculation_718605665807216655]==132&#13;&#10;THEN &apos;Occasional Buyer&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_718605665807216655] == 123&#13;&#10;THEN &apos;Low Engagement Potential&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_718605665806491660] == 1 AND [Calculation_718605665806790669] == 2 AND [Calculation_718605665807114254] &lt;= 2&#13;&#10;THEN &apos;Potential To Become Best Customer&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_718605665806790669] == 1&#13;&#10;THEN &apos;Loyal Customer&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_718605665807114254] == 1&#13;&#10;THEN &apos;Big Spenders&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_718605665807216655] == 311&#13;&#10;THEN &apos;Almost Lost&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_718605665807216655] == 411&#13;&#10;THEN &apos;Lost Customers&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_718605665807216655] == 444&#13;&#10;THEN &apos;Lost Cheap Customers&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_718605665806491660] == 2&#13;&#10;THEN &apos;Look Out Buyers&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_718605665806491660] &gt;= 2 AND [Calculation_718605665806790669] &gt;= 2&#13;&#10;THEN &apos;Occasional Buyers&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='corr' datatype='real' name='[Calculation_1156017780404367364]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CORR({ INCLUDE [Order ID]: SUM([Quantity])},{INCLUDE[Order ID (Sheet11)]:SUM([Quantity (Sheet11)])})' />
      </column>
      <column caption='Then Order Also Contains' datatype='string' name='[Calculation_2291769306385776640]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Sub-Category] &lt;&gt; [Parameters].[Sub-Category Parameter] THEN [Sub-Category] END' />
      </column>
      <column caption='Product Matches' datatype='integer' name='[Calculation_2291769306386231297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Sub-Category] = [Parameters].[Sub-Category Parameter] THEN 1 END' />
      </column>
      <column caption='Binder&apos;s discount' datatype='real' name='[Calculation_388435514526416896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Sub-Category] = &quot;Binders&quot; THEN [Discount] END' />
      </column>
      <column caption='Art  Sales' datatype='real' name='[Calculation_388435514528870401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Sub-Category] = &quot;Art&quot; THEN [Sales] END' />
      </column>
      <column caption='Storage Sales' datatype='real' name='[Calculation_388435514535481347]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Sub-Category] = &apos;Storage&apos; THEN [Sales] ELSE NULL END' />
      </column>
      <column caption='2022 year sales' datatype='real' name='[Calculation_388435515229184004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date]) = 2022 THEN [Sales] END' />
      </column>
      <column caption='2023 year sales' datatype='real' name='[Calculation_388435515229249541]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date]) = 2023 THEN [Sales] END' />
      </column>
      <column caption='% increase / decrease in sales' datatype='real' name='[Calculation_388435515251810312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Calculation_388435515229184004]) != 0 THEN&#13;&#10;    (SUM([Calculation_388435515229249541]) - SUM([Calculation_388435515229184004])) / SUM([Calculation_388435515229184004]) * 100&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
      </column>
      <column caption='max min' datatype='integer' name='[Calculation_388435515258982410]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MAX(COUNT([Order ID]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='profit ratio' datatype='real' datatype-customized='true' default-format='p0%' name='[Calculation_432908560258105344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
      </column>
      <column caption='discounts 2' datatype='string' name='[Calculation_432908560502108161]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Discount] &gt; 0 THEN &apos;Discounted&apos; ELSE &apos;Full Price&apos; END' />
      </column>
      <column caption='% of the segment of my total customers' datatype='real' default-format='p0.0%' name='[Calculation_659777396750069760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Customer Name])/795' />
      </column>
      <column caption='% of usa people' datatype='real' default-format='p0.0%' name='[Calculation_659777396798345219]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Customer Name])/COUNT([Country])' />
      </column>
      <column caption='Calculation2' datatype='real' name='[Calculation_659777396805222404]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_718605665807790096] = &apos;Lost Cheap Customer&apos; THEN&#13;&#10;    IF [Discount] &gt; 0 THEN &apos;Price&apos;&#13;&#10;    ELSEIF [Profit] &lt; 0 THEN &apos;Product Dissatisfaction&apos;&#13;&#10;    ELSE &apos;Other&apos;&#13;&#10;END' />
      </column>
      <column caption='RFM matric' datatype='real' name='[Calculation_718605665797844999]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1034983539567546385] * 100 + [Calculation_1034983539567706130] * 10 + [Calculation_1034983539570823187]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption=' RFM- R (how many days ago)' datatype='integer' name='[Calculation_718605665805987849]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,{ FIXED [Customer Name]:MAX([Order Date])},{MAX([Order Date])})' />
      </column>
      <column caption='RFM-F' datatype='integer' name='[Calculation_718605665806139402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='({ FIXED [Customer Name]:COUNTD([Order Date])})' />
      </column>
      <column caption='RFM-M' datatype='real' name='[Calculation_718605665806241803]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Customer Name]: SUM([Sales])}' />
      </column>
      <column caption='R-Score' datatype='integer' name='[Calculation_718605665806491660]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_718605665805987849] &lt;= {FIXED:PERCENTILE([Calculation_718605665805987849],0.25)} &#13;&#10;THEN 1&#13;&#10;ELSEIF [Calculation_718605665805987849] &gt; {FIXED:PERCENTILE([Calculation_718605665805987849],0.25)} AND [Calculation_718605665805987849] &lt;= {FIXED:PERCENTILE([Calculation_718605665805987849],0.5)}&#13;&#10;THEN 2&#13;&#10;ELSEIF [Calculation_718605665805987849] &gt; {FIXED:PERCENTILE([Calculation_718605665805987849],0.5)} AND [Calculation_718605665805987849] &lt;= {FIXED:PERCENTILE([Calculation_718605665805987849],0.75)}&#13;&#10;THEN 3&#13;&#10;ELSE 4&#13;&#10;END' />
      </column>
      <column caption='F-Score' datatype='integer' name='[Calculation_718605665806790669]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_718605665806139402] &lt;= {FIXED:PERCENTILE([Calculation_718605665806139402],0.25)} &#13;&#10;THEN 4&#13;&#10;ELSEIF [Calculation_718605665806139402] &gt; {FIXED:PERCENTILE([Calculation_718605665806139402],0.25)} AND [Calculation_718605665806139402] &lt;= {FIXED:PERCENTILE([Calculation_718605665806139402],0.5)}&#13;&#10;THEN 3&#13;&#10;ELSEIF [Calculation_718605665806139402] &gt; {FIXED:PERCENTILE([Calculation_718605665806139402],0.5)} AND [Calculation_718605665806139402] &lt;= {FIXED:PERCENTILE([Calculation_718605665806139402],0.75)}&#13;&#10;THEN 2&#13;&#10;ELSE 1&#13;&#10;END' />
      </column>
      <column caption='M-score' datatype='integer' name='[Calculation_718605665807114254]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_718605665806241803] &lt;= {FIXED:PERCENTILE([Calculation_718605665806241803],0.25)} &#13;&#10;THEN 4&#13;&#10;ELSEIF [Calculation_718605665806241803] &gt; {FIXED:PERCENTILE([Calculation_718605665806241803],0.25)} AND [Calculation_718605665806241803] &lt;= {FIXED:PERCENTILE([Calculation_718605665806241803],0.5)}&#13;&#10;THEN 3&#13;&#10;ELSEIF [Calculation_718605665806241803] &gt; {FIXED:PERCENTILE([Calculation_718605665806241803],0.5)} AND [Calculation_718605665806241803] &lt;= {FIXED:PERCENTILE([Calculation_718605665806241803],0.75)}&#13;&#10;THEN 2&#13;&#10;ELSE 1&#13;&#10;END' />
      </column>
      <column caption='RFM-score' datatype='integer' name='[Calculation_718605665807216655]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(STR([Calculation_718605665806491660])+STR([Calculation_718605665806790669])+STR([Calculation_718605665807114254]))' />
      </column>
      <column caption='RFM segments' datatype='string' name='[Calculation_718605665807790096]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_718605665807216655] == 111&#13;&#10;&#13;&#10;THEN &apos;Best Customers&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_718605665806491660] == 1 AND [Calculation_718605665806790669] == 2 AND [Calculation_718605665807114254] &lt;=2&#13;&#10;&#13;&#10;THEN &apos;Potential To Become Best Customer&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_718605665806790669] == 1&#13;&#10;&#13;&#10;THEN &apos;Loyal Customer&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_718605665807114254] == 1&#13;&#10;&#13;&#10;THEN &apos;Big Spenders&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_718605665807216655] == 311&#13;&#10;&#13;&#10;THEN &apos;Almost Lost&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_718605665807216655] == 411&#13;&#10;&#13;&#10;THEN &apos;Lost Customers&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_718605665807216655] == 444&#13;&#10;&#13;&#10;THEN &apos;Lost Cheap Customers&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_718605665806491660] = 2&#13;&#10;&#13;&#10;THEN &apos;Look Out Buyers&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_718605665806491660] &gt;= 2 AND [Calculation_718605665806790669] &gt;= 2&#13;&#10;&#13;&#10;THEN &apos;Occasional Buyers&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='overall max order date' datatype='date' name='[Calculation_718605665814540305]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX([Order Date])}' />
      </column>
      <column caption='label&apos;s discount' datatype='real' name='[Calculation_811773884078309376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Sub-Category] = &quot;Labels&quot; THEN [Discount] END' />
      </column>
      <column caption='label&apos;s Sales' datatype='real' name='[Calculation_811773884078424065]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Sub-Category] = &quot;Labels&quot; THEN [Sales] END' />
      </column>
      <column caption='copier&apos;s discount' datatype='real' name='[Calculation_811773884078555138]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Sub-Category] = &quot;Copiers&quot; THEN [Discount] END' />
      </column>
      <column caption='copier&apos;s sales' datatype='real' name='[Calculation_811773884078686211]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Sub-Category] = &quot;Copiers&quot; THEN [Sales] END' />
      </column>
      <column caption='Profit with binder discount =0' datatype='real' name='[Calculation_919578799464177666]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_388435514526416896] = 0 THEN [Profit] END' />
      </column>
      <column caption='total sales for other sub categories' datatype='real' name='[Calculation_919578799564103686]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Sub-Category] &lt;&gt; &apos;Binders&apos; THEN [Sales] END' />
      </column>
      <column caption='support of the category( relative frequency )' datatype='real' name='[Calculation_949133669901217792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Order ID]) / TOTAL(COUNTD([Order ID]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Distinct sub category per Order' datatype='integer' name='[Calculation_949133669903265793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Sub-Category])' />
      </column>
      <column caption='cross purchases' datatype='integer' name='[Calculation_949133669903462402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNTD([Sub-Category]) &gt; 1 THEN 1 ELSE 0 END' />
      </column>
      <column caption='profit margin' datatype='real' datatype-customized='true' name='[Calculation_949133669997817859]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales]) * 100' />
      </column>
      <column caption='subcategories together' datatype='string' name='[Calculation_949133670356512772]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Sub-Category]+&apos; &amp; &apos;+[Sub-Category (Sheet11)]' />
      </column>
      <column caption='delivery status' datatype='string' name='[Calculation_984036570247475200]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Ship Mode] = &apos;Same Day&apos; AND [Ship Date] = [Order Date] THEN &apos;Delivered on Time&apos;&#13;&#10;ELSE &apos;Not Delivered on Time&apos; END' />
      </column>
      <column caption='% of segements' datatype='real' name='[Calculation_984036570277359617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Segment] = &apos;Consumer&apos; THEN 1 ELSE 0 END) / COUNT([Customer Name]) * 100' />
      </column>
      <column caption='distinct cn' datatype='integer' name='[Calculation_984036570279223299]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Customer Name])' />
      </column>
      <column caption='current period' datatype='real' name='[Calculation_984036570307461129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Order Date] &gt;= DATEADD(&apos;month&apos;, -1, TODAY()) AND [Order Date] &lt;= TODAY() THEN [Sales] END)' />
      </column>
      <column caption='previous period' datatype='real' name='[Calculation_984036570307878922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Order Date] &gt;= DATEADD(&apos;month&apos;, -2, TODAY()) AND [Order Date] &lt; DATEADD(&apos;month&apos;, -1, TODAY()) THEN [Sales] END)' />
      </column>
      <column caption='growth rate' datatype='real' name='[Calculation_984036570310209547]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_984036570307878922] != 0 THEN&#13;&#10;    ([Calculation_984036570307461129] - [Calculation_984036570307878922]) / [Calculation_984036570307878922] * 100&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
      </column>
      <column caption='CAGR' datatype='real' default-format='p0.0%' name='[Calculation_984036570315018253]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='POWER(ZN(SUM([Sales]))/LOOKUP(ZN(SUM([Sales])),-[Parameters].[Parameter 2]), &#13;&#10;ZN(1/[Parameters].[Parameter 2])) - 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Profit CAGR' datatype='real' default-format='p0.0%' name='[Calculation_984036570357190674]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='POWER(ZN(SUM([Profit]))/LOOKUP(ZN(SUM([Profit])),-[Parameters].[Parameter 2]), &#13;&#10;ZN(1/[Parameters].[Parameter 2])) - 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sales per customer' datatype='real' name='[Calculation_984036570591445011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / COUNTD([Customer Name])' />
      </column>
      <column caption='Profit per customer' datatype='real' name='[Calculation_984036570591641620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / COUNTD([Customer Name])' />
      </column>
